# ==============================================================================
# DALEEL (دليل) — Production Configuration
# Stack: Neon Serverless Postgres, Neon Auth, Neon Object Storage (my-bucket)
# Note: Zero AI models or external AI APIs are integrated.
# ==============================================================================

# Application Port & Base URL
PORT=3000
APP_URL="https://my-daleel-app.aistudio.com"

# Neon PostgreSQL (Project: Dalil | Branch: production)
# Connection string provided in the Neon console. If unset, uses built-in in-memory fallback.
DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Managed Better Auth session secret)
SESSION_SECRET="your-32-character-session-secret-here"
NEON_AUTH_URL="https://auth.neon.tech"

# Neon Object Storage (Bucket: my-bucket)
# S3-compatible credentials for document & trip photo uploads/downloads
NEON_STORAGE_BUCKET="my-bucket"
NEON_STORAGE_ENDPOINT="https://storage.neon.tech"
NEON_STORAGE_REGION="us-east-1"
NEON_STORAGE_ACCESS_KEY_ID=""
NEON_STORAGE_SECRET_ACCESS_KEY=""

# Optional Google Maps API key for interactive mapping
VITE_GOOGLE_MAPS_API_KEY=""
