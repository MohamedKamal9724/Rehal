+import { initializeApp, getApps } from 'firebase/app';
+import { initializeAuth, browserSessionPersistence, browserPopupRedirectResolver } from 'firebase/auth';
+export type Realm = 'traveler' | 'operator';
+export function getRealmAuth(realm: Realm) {
+  const env = import.meta.env;
+  const prefix = realm === 'traveler' ? 'VITE_TRAVELER_FIREBASE_' : 'VITE_OPERATOR_FIREBASE_';
+  const config = { apiKey:env[`${prefix}API_KEY`], authDomain:env[`${prefix}AUTH_DOMAIN`], projectId:env[`${prefix}PROJECT_ID`], appId:env[`${prefix}APP_ID`] };
+  if (Object.values(config).some(v => !v)) throw new Error('خدمة الدخول غير متاحة حاليًا. يرجى المحاولة لاحقًا.');
+  if (env.VITE_TRAVELER_FIREBASE_PROJECT_ID === env.VITE_OPERATOR_FIREBASE_PROJECT_ID) throw new Error('إعدادات الخدمة غير مكتملة. يرجى التواصل مع الدعم.');
+  const name = `daleel-${realm}`;
+  const existing = getApps().find(a => a.name === name);
+  const app = existing || initializeApp(config,name);
+  return initializeRealm(app);
+}
+import { getAuth } from 'firebase/auth';
+import type { FirebaseApp } from 'firebase/app';
+function initializeRealm(app:FirebaseApp) {
+  try { return initializeAuth(app,{ persistence:browserSessionPersistence, popupRedirectResolver:browserPopupRedirectResolver }); }
+  catch (error) { if ((error as {code?:string}).code === 'auth/already-initialized') return getAuth(app); throw error; }
+}
